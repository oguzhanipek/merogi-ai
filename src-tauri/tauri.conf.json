{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Merogi AI",
  "version": "0.2.0",
  "identifier": "com.merogi.ai",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Merogi AI",
        "width": 1360,
        "height": 880,
        "minWidth": 1080,
        "minHeight": 700,
        "theme": "Dark",
        "backgroundColor": "#120D16"
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "deb"
    ],
    "category": "Video",
    "shortDescription": "Local AI video character replacement studio",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/THIRD_PARTY_LICENSES.md": "THIRD_PARTY_LICENSES.md"
    },
    "license": "MIT",
    "licenseFile": "../LICENSE"
  }
}